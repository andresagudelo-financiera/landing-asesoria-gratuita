---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Mentoría Privada | Finanzas con Claudia Uribe"
  description="Construyes tu plan financiero personalizado — con tus números, tu meta de retiro y tu estrategia de inversión."
>
  <section class="min-h-screen relative flex items-center justify-center pt-32 pb-16 overflow-hidden">
    <!-- Image Background with Blur -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/black_v2.webp" alt="Fondo" class="w-full h-full object-cover opacity-40 blur-2xl scale-110" />
      <div class="absolute inset-0 bg-[#0b0b10]/70"></div>
    </div>

    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-claudia-accent-orange/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-rebellion relative z-10 pt-4 lg:pt-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-center">
        <!-- Copy & Context -->
        <div class="space-y-8">
        <div class="inline-block px-4 py-2 rounded-full bg-claudia-accent-orange/20 border border-claudia-accent-orange/30 text-claudia-accent-orange text-sm font-bold tracking-widest uppercase mb-4">
          CUPOS LIMITADOS · 10 PERSONAS
        </div>
        
        <h1 class="text-4xl lg:text-6xl font-black text-off-white leading-tight">
          Tu plan financiero <br/>
          <span class="bg-gradient-to-r from-orange-400 to-yellow-500 bg-clip-text text-transparent">y eficiencia tributaria.</span><br/>
          En dos sesiones.
        </h1>
        
        <p class="text-xl text-soft-gray font-medium leading-relaxed">
          Si cumples con el perfil, esta es tu oportunidad para estructurar tu patrimonio, tener un plan financiero claro y pagar menos impuestos de forma 100% legal.
        </p>

        <ul class="space-y-6 mt-8">
          <li class="flex items-start gap-4 text-soft-gray">
            <div class="w-6 h-6 rounded-full bg-claudia-accent-orange/20 flex items-center justify-center shrink-0 mt-1">
                <svg class="w-4 h-4 text-claudia-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <span><strong class="text-white">Construyes tu plan financiero personalizado</strong> — con tus números, tu meta de retiro y tu estrategia de inversión.</span>
          </li>
          <li class="flex items-start gap-4 text-soft-gray">
            <div class="w-6 h-6 rounded-full bg-claudia-accent-orange/20 flex items-center justify-center shrink-0 mt-1">
                <svg class="w-4 h-4 text-claudia-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <span><strong class="text-white">Auditoría de eficiencia tributaria:</strong> identificamos cuánto estás pagando de más en impuestos y las estrategias legales para reducirlo.</span>
          </li>
          <li class="flex items-start gap-4 text-soft-gray">
            <div class="w-6 h-6 rounded-full bg-claudia-accent-orange/20 flex items-center justify-center shrink-0 mt-1">
                <svg class="w-4 h-4 text-claudia-accent-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <span><strong class="text-white">Acceso a un círculo privado</strong> con Claudia durante 6 meses para seguimiento y decisiones con certeza.</span>
          </li>
        </ul>
      </div>

      <!-- Form Section -->
      <div class="flex flex-col items-center relative mt-12 lg:mt-0">
        <!-- Claudia Profile Card (Overlapping Top) -->
        <div class="relative z-20 w-[95%] max-w-[480px] -mb-12 lg:-mb-16">
          <div class="flex items-center gap-6 p-8 rounded-3xl bg-[#0f172a] border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
            <!-- Circular Frame with popping head -->
            <div class="relative w-32 h-32 shrink-0 mt-2">
              <!-- Background Circle -->
              <div class="absolute inset-0 rounded-full border-2 border-claudia-accent-orange/30 bg-claudia-dark z-0 shadow-inner"></div>
              <!-- Popping Image -->
              <img src="/6f.png" alt="Claudia Uribe" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[135%] h-auto object-contain object-bottom z-10 pointer-events-none drop-shadow-2xl" style="max-height: 160%;" onerror="this.src='/6.png';" />
            </div>
            <div class="relative z-10 flex-1">
              <p class="text-white font-black text-2xl leading-tight">Claudia Uribe</p>
              <p class="text-claudia-accent-orange text-base font-bold mb-3 tracking-wide">Money Strategist</p>
              <p class="text-soft-gray text-sm italic leading-relaxed">"Diseñaremos la estrategia ideal para estructurar tu patrimonio y blindar tu tranquilidad."</p>
            </div>
          </div>
        </div>

        <!-- Form Card -->
        <div class="relative group w-full">
          <div class="absolute -inset-1 bg-gradient-to-r from-claudia-accent-orange to-orange-400 rounded-3xl blur-lg opacity-20 group-hover:opacity-40 transition duration-1000"></div>
          <div class="relative glassmorphism rounded-3xl p-8 lg:p-10 pt-20 lg:pt-24 border border-white/10 bg-[#0f172a]/80 backdrop-blur-xl">
            <h3 class="text-2xl font-bold text-white mb-6 text-center">Aplica a la mentoría</h3>
          <form id="mentoria-form" class="space-y-6" novalidate>
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="nombre" class="text-sm font-medium text-soft-gray">Nombre</label>
                <input type="text" id="nombre" name="nombre" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition" placeholder="Tu nombre" />
              </div>
              <div class="space-y-2">
                <label for="apellido" class="text-sm font-medium text-soft-gray">Apellido</label>
                <input type="text" id="apellido" name="apellido" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition" placeholder="Tu apellido" />
              </div>
            </div>
            
            <div class="space-y-2">
              <label for="email" class="text-sm font-medium text-soft-gray">Correo electrónico</label>
              <input type="email" id="email" name="email" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition" placeholder="tu@correo.com" />
            </div>

            <div class="space-y-2">
              <label for="celular" class="text-sm font-medium text-soft-gray">Número de celular (WhatsApp)</label>
              <div class="flex gap-2">
                <div class="relative w-[35%] min-w-[110px]">
                  <select id="countryCode" name="countryCode" required class="w-full bg-black/50 border border-white/10 rounded-xl px-2 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition appearance-none">
                    <option value="+57">🇨🇴 +57</option>
                    <option value="+52">🇲🇽 +52</option>
                    <option value="+54">🇦🇷 +54</option>
                    <option value="+56">🇨🇱 +56</option>
                    <option value="+51">🇵🇪 +51</option>
                    <option value="+593">🇪🇨 +593</option>
                    <option value="+1">🇺🇸 +1</option>
                    <option value="+34">🇪🇸 +34</option>
                    <option value="+507">🇵🇦 +507</option>
                    <option value="+506">🇨🇷 +506</option>
                  </select>
                  <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none">
                      <svg class="w-4 h-4 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </div>
                </div>
                <input type="tel" id="celular" name="celular" required inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')" class="flex-1 bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition" placeholder="3000000000" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="capital" class="text-sm font-medium text-soft-gray">Cuánto capital líquido tienes</label>
              <div class="relative">
                <select id="capital" name="capital" required class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-claudia-accent-orange focus:ring-1 focus:ring-claudia-accent-orange transition appearance-none">
                  <option value="" disabled selected>Selecciona una opción</option>
                  <option value="Menos de $50,000 USD">Menos de $50,000 USD</option>
                  <option value="Entre $50,000 y $100,000 USD">Entre $50,000 y $100,000 USD</option>
                  <option value="Entre $100,000 y $200,000 USD">Entre $100,000 y $200,000 USD</option>
                  <option value="Más de $200,000 USD">Más de $200,000 USD</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none">
                    <svg class="w-4 h-4 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
            </div>

            <div id="extra-question-container" class="space-y-2 hidden mt-4">
              <label class="text-sm font-medium text-soft-gray">¿Estarías dispuesto a invertir $5.000 USD en una mentoría directa con Claudia Uribe, donde aprenderás a hacer crecer tu capital entre un 10% y un 20% efectivo anual, según tu perfil de riesgo?</label>
              <div class="flex gap-4 mt-2">
                <label class="flex-1 relative cursor-pointer">
                  <input type="radio" name="dispuestoInvertir" value="Sí" class="peer sr-only">
                  <div class="w-full text-center bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white peer-checked:bg-claudia-accent-orange/20 peer-checked:border-claudia-accent-orange peer-checked:text-claudia-accent-orange transition-all font-medium">Sí</div>
                </label>
                <label class="flex-1 relative cursor-pointer">
                  <input type="radio" name="dispuestoInvertir" value="No" class="peer sr-only">
                  <div class="w-full text-center bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white peer-checked:bg-claudia-accent-orange/20 peer-checked:border-claudia-accent-orange peer-checked:text-claudia-accent-orange transition-all font-medium">No</div>
                </label>
              </div>
            </div>

            <button id="mentoria-submit-btn" type="submit" class="relative w-full mt-4 px-8 py-4 bg-gradient-to-r from-orange-500 to-yellow-600 hover:from-orange-600 hover:to-yellow-700 text-white font-bold uppercase tracking-wider rounded-xl shadow-[0_0_30px_rgba(255,152,0,0.3)] transition-all duration-300 hover:-translate-y-1 flex items-center justify-center gap-2">
              <svg id="mentoria-btn-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="mentoria-btn-text">Solicitar Evaluación</span>
            </button>
            <p class="text-center text-[11px] text-soft-gray/60 mt-4 leading-tight px-4">
                *Las aplicaciones son revisadas por nuestro comité. Solo se admitirán perfiles que cumplan el requerimiento de capital.
            </p>
          </form>

          <!-- Success Message -->
          <div id="mentoria-success-msg" class="hidden text-center py-8">
            <div class="w-20 h-20 mx-auto bg-green-500/20 text-green-500 rounded-full flex items-center justify-center mb-6">
              <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">¡Solicitud Recibida!</h3>
            <p class="text-soft-gray mb-6">
              Hemos recibido tu información con éxito. Nuestro equipo revisará tu perfil y se pondrá en contacto contigo en breve para agendar la mentoría si cumples con los requisitos.
            </p>
          </div>
        </div>

        <!-- Testimonial (Social Proof) -->
        <div class="w-full mt-8 relative p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md shadow-xl">
          <div class="flex gap-4">
            <div class="shrink-0 text-orange-500">
              <svg class="w-8 h-8 opacity-50" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>
            <div>
              <p class="text-soft-gray text-sm italic leading-relaxed mb-4">
                "Trabajar con Claudia marcó un antes y un después. Logramos reestructurar mi portafolio, optimizar mi carga tributaria en un 30% legalmente y trazar una ruta clara para el retiro. Es el nivel de certeza que cualquier empresario serio necesita."
              </p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center border border-white/10 shadow-inner">
                  <span class="text-white font-bold text-sm">CM</span>
                </div>
                <div>
                  <p class="text-white font-bold text-sm">Carlos M.</p>
                  <p class="text-orange-400 text-[11px] uppercase tracking-wider font-semibold">Empresario & Inversionista</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Exclusivity Gate Modal -->
  <div id="exclusivity-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md px-4 transition-opacity duration-500">
    <div class="max-w-2xl w-full text-center">
      <div class="inline-block p-[2px] rounded-[24px] bg-gradient-to-r from-red-600/40 via-orange-500/40 to-red-600/40 shadow-[0_0_50px_rgba(239,68,68,0.2)]">
        <div class="bg-[#0a0a0f] rounded-[22px] p-8 md:p-12 border border-red-500/10 shadow-inner">
          <div class="flex items-center justify-center gap-3 mb-6">
            <svg class="w-10 h-10 text-red-500 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span class="text-red-500 font-black tracking-[0.2em] uppercase text-2xl md:text-3xl">Alerta</span>
          </div>
          <h2 class="text-2xl md:text-4xl font-bold text-white leading-tight mb-6">
            Esta página es exclusiva para <br class="hidden md:block"/>
            Inversionistas o Empresarios con capital líquido <br class="hidden md:block"/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500 font-black text-4xl md:text-5xl block mt-4 mb-2">> $50,000 USD</span>
          </h2>
          <p class="text-lg md:text-xl text-soft-gray font-medium mb-10">
            Si no cumples con este perfil, <strong class="text-red-400">cierra esta página.</strong><br/>
            La mentoría privada no está diseñada para ti.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <button id="accept-modal-btn" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-orange-500 to-yellow-600 hover:from-orange-600 hover:to-yellow-700 text-white font-bold uppercase tracking-wider rounded-xl shadow-[0_0_30px_rgba(255,152,0,0.3)] transition-all duration-300 hover:-translate-y-1">
              Sí, continuar
            </button>
            <a href="/" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-soft-gray font-medium uppercase tracking-wider rounded-xl transition-colors duration-300">
              No, regresar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification / Error Modal -->
  <div id="notification-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm px-4 transition-opacity duration-300 opacity-0">
    <div class="max-w-md w-full text-center transform scale-95 transition-transform duration-300" id="notification-modal-content">
      <div class="bg-[#0f172a] rounded-2xl p-8 border border-white/10 shadow-2xl relative">
        <button id="close-notification-btn" class="absolute top-4 right-4 text-soft-gray hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        
        <div id="notification-icon" class="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4">
          <!-- Icon injected via JS -->
        </div>
        <h3 id="notification-title" class="text-xl font-bold text-white mb-2"></h3>
        <p id="notification-message" class="text-soft-gray mb-6"></p>
        
        <button id="notification-action-btn" class="w-full px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl transition-colors">
          Entendido
        </button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Validaciones estrictas por país
      const phoneValidations: Record<string, { regex: RegExp, error: string }> = {
        '+57': { regex: /^3\d{9}$/, error: 'En Colombia, el celular debe tener 10 dígitos y empezar por 3 (no repitas el 57).' },
        '+52': { regex: /^\d{10}$/, error: 'En México, el celular debe tener 10 dígitos (no repitas el 52).' },
        '+54': { regex: /^\d{10}$/, error: 'En Argentina, el celular debe tener 10 dígitos (código de área + número sin 15).' },
        '+56': { regex: /^9\d{8}$/, error: 'En Chile, el celular debe tener 9 dígitos y empezar por 9 (no repitas el 56).' },
        '+51': { regex: /^9\d{8}$/, error: 'En Perú, el celular debe tener 9 dígitos y empezar por 9.' },
        '+593': { regex: /^9\d{8}$/, error: 'En Ecuador, el celular debe tener 9 dígitos y empezar por 9.' },
        '+1': { regex: /^\d{10}$/, error: 'En USA/Canadá, el celular debe tener 10 dígitos (no repitas el 1).' },
        '+34': { regex: /^[67]\d{8}$/, error: 'En España, el celular debe tener 9 dígitos y empezar por 6 o 7.' },
        '+507': { regex: /^6\d{7}$/, error: 'En Panamá, el celular debe tener 8 dígitos y empezar por 6.' },
        '+506': { regex: /^[678]\d{7}$/, error: 'En Costa Rica, el celular debe tener 8 dígitos y empezar por 6, 7 u 8.' }
      };

      // Capital Select Logic
      const capitalSelect = document.getElementById('capital');
      const extraQuestionContainer = document.getElementById('extra-question-container');
      const dispuestoInvertirRadios = document.querySelectorAll('input[name="dispuestoInvertir"]');

      if (capitalSelect && extraQuestionContainer && dispuestoInvertirRadios.length) {
        capitalSelect.addEventListener('change', (e) => {
          if ((e.target as HTMLSelectElement).value === 'Menos de $50,000 USD') {
            extraQuestionContainer.classList.remove('hidden');
          } else {
            extraQuestionContainer.classList.add('hidden');
            dispuestoInvertirRadios.forEach((radio: any) => radio.checked = false);
          }
        });
      }

      // Exclusivity Modal Logic
      const modal = document.getElementById('exclusivity-modal');
      const acceptBtn = document.getElementById('accept-modal-btn');
      
      if (modal && acceptBtn) {
        if (!sessionStorage.getItem('mentoria-accepted')) {
          modal.style.display = 'flex';
        } else {
          modal.style.display = 'none';
        }

        acceptBtn.addEventListener('click', () => {
          sessionStorage.setItem('mentoria-accepted', 'true');
          modal.style.opacity = '0';
          setTimeout(() => {
            modal.style.display = 'none';
          }, 500);
        });
      }

      // Notification Modal Logic
      const notifModal = document.getElementById('notification-modal');
      const notifContent = document.getElementById('notification-modal-content');
      const notifIcon = document.getElementById('notification-icon');
      const notifTitle = document.getElementById('notification-title');
      const notifMessage = document.getElementById('notification-message');
      const closeNotifBtn = document.getElementById('close-notification-btn');
      const actionNotifBtn = document.getElementById('notification-action-btn');

      const hideNotification = () => {
        if(notifModal && notifContent) {
          notifModal.classList.remove('opacity-100');
          notifModal.classList.add('opacity-0');
          notifContent.classList.remove('scale-100');
          notifContent.classList.add('scale-95');
          setTimeout(() => {
            notifModal.classList.add('hidden');
            notifModal.classList.remove('flex');
          }, 300);
        }
      };

      if(closeNotifBtn) closeNotifBtn.addEventListener('click', hideNotification);
      if(actionNotifBtn) actionNotifBtn.addEventListener('click', hideNotification);

      const showNotification = (type: 'error' | 'success', title: string, message: string) => {
        if(!notifModal || !notifTitle || !notifMessage || !notifIcon || !notifContent) return;

        notifTitle.textContent = title;
        notifMessage.textContent = message;

        if (type === 'error') {
          notifIcon.className = 'w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4 bg-red-500/20 text-red-500';
          notifIcon.innerHTML = `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
        } else {
          notifIcon.className = 'w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4 bg-green-500/20 text-green-500';
          notifIcon.innerHTML = `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
        }

        notifModal.classList.remove('hidden');
        notifModal.classList.add('flex');
        
        // Trigger reflow for transition
        void notifModal.offsetWidth;
        
        notifModal.classList.remove('opacity-0');
        notifModal.classList.add('opacity-100');
        notifContent.classList.remove('scale-95');
        notifContent.classList.add('scale-100');
      };

      // Form Submission Logic
      const form = document.getElementById('mentoria-form') as HTMLFormElement;
      const submitBtn = document.getElementById('mentoria-submit-btn') as HTMLButtonElement;
      const btnText = document.getElementById('mentoria-btn-text');
      const btnSpinner = document.getElementById('mentoria-btn-spinner');
      const successMsg = document.getElementById('mentoria-success-msg');

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          // 1. Get Form Data
          const formData = new FormData(form as HTMLFormElement);
          
          const requiredFields = [
            { name: 'nombre', label: 'Nombre' },
            { name: 'apellido', label: 'Apellidos' },
            { name: 'email', label: 'Correo Electrónico' },
            { name: 'countryCode', label: 'Indicativo de País' },
            { name: 'celular', label: 'Número de Celular' },
            { name: 'capital', label: 'Capital Líquido' }
          ];

          for (const field of requiredFields) {
            if (!formData.get(field.name) || (formData.get(field.name) as string).trim() === '') {
              showNotification('error', 'Faltan datos', `El campo "${field.label}" es obligatorio.`);
              return;
            }
          }

          if (formData.get('capital') === 'Menos de $50,000 USD' && !formData.get('dispuestoInvertir')) {
             showNotification('error', 'Faltan datos', `Por favor responde si estarías dispuesto a invertir en la mentoría.`);
             return;
          }
          
          let rawPhone = (formData.get('celular') as string) || '';
          let countryCode = (formData.get('countryCode') as string) || '+57';
          
          // Limpiar número (remover espacios, guiones, paréntesis)
          let cleanPhone = rawPhone.replace(/[\s\-()]/g, '');

          const validation = phoneValidations[countryCode];
          if (validation && !validation.regex.test(cleanPhone)) {
             showNotification('error', 'Número de WhatsApp inválido', validation.error);
             return; // Detener el envío para que el usuario lo corrija
          }
          
          const fullPhone = `${countryCode} ${cleanPhone}`;

          const data: any = {
            nombre: formData.get('nombre'),
            apellido: formData.get('apellido'),
            email: formData.get('email'),
            phone: fullPhone,
            capital: formData.get('capital'),
            dispuestoInvertir: formData.get('dispuestoInvertir'),
            source: window.location.href,
            page: 'Mentoría High-Ticket'
          };

          // 2. Capture UTMs
          const urlParams = new URLSearchParams(window.location.search);
          const utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
          utms.forEach(utm => {
            if (urlParams.has(utm)) {
              data[utm] = urlParams.get(utm);
            }
          });

          // 3. UI Loading State
          (submitBtn as HTMLButtonElement).disabled = true;
          if(btnText) btnText.textContent = "Enviando...";
          if(btnSpinner) btnSpinner.classList.remove('hidden');

          try {
            // 4. Send to Webhook
            let webhookUrl = 'https://services.leadconnectorhq.com/hooks/glYhQdAwhCpqHLt5CCIH/webhook-trigger/ce8gSjYfOIEWc6EF4F4H';
            let payloadToSend = { ...data };
            
            if (data.capital === 'Menos de $50,000 USD' && data.dispuestoInvertir === 'No') {
              webhookUrl = 'https://services.leadconnectorhq.com/hooks/vEh7JAwgMFnBubxjOxId/webhook-trigger/8b06b917-b26c-4535-bd62-0886f99b0e3e';
              
              const isAds = data.utm_source && (data.utm_source.toLowerCase().includes('ads') || data.utm_source.toLowerCase().includes('meta'));
              
              payloadToSend = {
                "nombre": data.nombre,
                "first-name": data.nombre,
                "last-name": data.apellido,
                "email": data.email,
                "telefono": data.phone,
                "ocupacion": "none",
                "fecha": new Date().toISOString(),
                "capital_liquido": data.capital,
                "dispuesto_invertir": data.dispuestoInvertir,
                "agencia": isAds ? "Escalads Groupe" : "Asygnuz",
                "fuente": isAds ? "ADS" : "Organico",
                "nivel_calificacion": "Baja",
                ...data
              };
            }

            const response = await fetch(webhookUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payloadToSend)
            });

            if (response.ok) {
               // Success UI
               form.style.display = 'none';
               if(successMsg) successMsg.classList.remove('hidden');
               
               // Trigger tracking pixels
               if (typeof window !== 'undefined') {
                 if ((window as any).fbq) {
                   (window as any).fbq('track', 'Lead', { currency: 'USD', value: 50000 });
                 }
                 if ((window as any).gtag) {
                   (window as any).gtag('event', 'generate_lead', { currency: 'USD', value: 50000 });
                 }
               }
            } else {
               showNotification('error', 'Ocurrió un error', 'Hubo un error al enviar tu solicitud. Por favor intenta nuevamente.');
               (submitBtn as HTMLButtonElement).disabled = false;
               if(btnText) btnText.textContent = "Solicitar Evaluación";
               if(btnSpinner) btnSpinner.classList.add('hidden');
            }
          } catch (error) {
             console.error('Error submitting form:', error);
             showNotification('error', 'Error de conexión', 'No pudimos conectar con el servidor. Por favor revisa tu internet e intenta nuevamente.');
             (submitBtn as HTMLButtonElement).disabled = false;
             if(btnText) btnText.textContent = "Solicitar Evaluación";
             if(btnSpinner) btnSpinner.classList.add('hidden');
          }
        });
      }
    });
  </script>
</MainLayout>
